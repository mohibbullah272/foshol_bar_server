model payment {
  id        Int            @id @default(autoincrement())
  userId    Int
  projectId Int
  method    PaymentMethods
  amount    Int
  status    paymentStatus
  project   Project        @relation(fields: [projectId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
}

enum PaymentMethods {
  BKASH
  NAGAD
  ROCKET
  UPAY
  BANK
  UCB
}

enum paymentStatus {
  APPROVED
  PENDING
}

model KYC {
  id                     Int       @id @default(autoincrement())
  userId                 Int       @unique
  nidNumber              BigInt?   @unique
  birthCertificateNumber BigInt?   @unique
  passportNumber         BigInt?   @unique
  passportImage          String?
  birthCertificateImage  String?
  userImage              String
  nidImage               String?
  status                 KycStatus @default(NOTREQUSTED)
  user                   User      @relation(fields: [userId], references: [id])
}

enum KycStatus {
  NOTREQUSTED
  APPROVED
  PENDING
  REJECTED
}

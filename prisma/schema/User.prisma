model User {
  id           Int            @id @default(autoincrement())
  name         String?
  email        String?        @unique
  password     String
  photo        String?
  address      String?
  phone        String         @unique
  role         Role           @default(INVESTOR)
  status       Status         @default(PENDING)
  createdAt    DateTime       @default(now())
  Conversation Conversation[]
  Investment   Investment[]
  KYC          KYC?
  payment      payment[]

 

  NotificationDeliver NotificationDeliver[]

  Rivew Rivew[]
}

enum Role {
  INVESTOR
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  BLOCKED
}
